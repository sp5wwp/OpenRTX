/*
 * Radtel RT-950 Pro, Artery AT32F403AVGT7 (Cortex-M4F, 1MB flash, 96kB or 224kB SRAM)
 */

/dts-v1/;
#include <at/at32f403a_407/at32f403avgt7.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "rt950pro-pinctrl.dtsi"

/ {
	model = "Radtel RT-950 Pro";
	compatible = "radtel,rt950pro";

	aliases {
		gps = &usart3;
		bluetooth = &usart1;
	};

	chosen {
		zephyr,console = &usart4;
		zephyr,shell-uart = &usart4;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &code_partition;
		zephyr,display = &st7789v;
	};

	/*
	 * ST7789V 240x320 IPS panel on an 8-bit 8080 parallel bus, bit-banged
	 * on GPIOD. The data lines share GPIOD with the keypad rows (PD4-PD7):
	 * the bit-bang driver only touches the data/control pins.
	 */
	mipi_dbi: mipi-dbi {
		compatible = "zephyr,mipi-dbi-bitbang";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		wr-gpios = <&gpiod 0 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&gpiod 1 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpiod 2 GPIO_ACTIVE_LOW>;
		dc-gpios = <&gpiod 3 GPIO_ACTIVE_HIGH>;
		data-gpios = <&gpiod 8 GPIO_ACTIVE_HIGH>,
			     <&gpiod 9 GPIO_ACTIVE_HIGH>,
			     <&gpiod 10 GPIO_ACTIVE_HIGH>,
			     <&gpiod 11 GPIO_ACTIVE_HIGH>,
			     <&gpiod 12 GPIO_ACTIVE_HIGH>,
			     <&gpiod 13 GPIO_ACTIVE_HIGH>,
			     <&gpiod 14 GPIO_ACTIVE_HIGH>,
			     <&gpiod 15 GPIO_ACTIVE_HIGH>;

		/* Init values from the vendor firmware V0.27 LCD_Init sequence */
		st7789v: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			mipi-max-frequency = <20000000>;
			mipi-mode = "MIPI_DBI_MODE_8080_BUS_8_BIT";
			width = <240>;
			height = <320>;
			x-offset = <0>;
			y-offset = <0>;
			vcom = <0x3f>;
			gctrl = <0x35>;
			vrhs = <0x0f>;
			vdvs = <0x20>;
			mdac = <0xc0>;
			gamma = <0x01>;
			colmod = <0x05>;
			lcm = <0x2c>;
			porch-param = [05 05 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 05 09 09 08 14 28 33 3f 07 13 14 28 30];
			nvgam-param = [d0 05 09 09 08 03 24 32 32 3b 14 13 28 2f];
			ram-param = [00 f0];
			rgb-param = [cd 08 14];
		};
	};

	/*
	 * Shared BK4829 half-duplex bus. Chip selects are controlled by the
	 * BK4829 driver across the command and data transfers.
	 */
	bk4829_spi: bk4829-spi {
		compatible = "zephyr,spi-bitbang";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		clk-gpios = <&gpioe 10 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpioe 11 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * Board GPIOs used directly by the OpenRTX platform, display and
	 * keyboard drivers.
	 */
	zephyr,user {
		io-channels = <&adc1 1>;
		io-channel-names = "vbat";

		/*
		 * Bluetooth module enable, high powers it on. The vendor firmware
		 * sets it high when the Bluetooth setting is on and low
		 * otherwise, right after configuring USART1.
		 */
		bt-pwr-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;

		/* Power/volume knob switch, low when the radio is switched on */
		pwr-switch-gpios = <&gpioe 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

		/* Power off */
		pwr-enable-gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;

		/* GPS power enable, active low */
		gps-pwr-gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;

		led-red-gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
		led-green-gpios = <&gpioc 14 GPIO_ACTIVE_HIGH>;

		/*
		 * BK4829 chip selects. The first transceiver (PE8) is wired to
		 * the VHF LNA and PA, the second one (PE15) to the UHF ones.
		 */
		bk4829-scn-gpios = <&gpioe 8 GPIO_ACTIVE_LOW>,
				   <&gpioe 15 GPIO_ACTIVE_LOW>;

		/*
		 * RF path switches, active high and idle low. Names are the
		 * PCB net names found by reverse
		 * engineering: U6R/U3R are RX path enables, V3R selects the
		 * VHF RX frontend, U3T/V3T/SW3T are the TX path and PA gate.
		 * PC4 (antenna band relay) is not handled.
		 */
		rf-u6r-gpios = <&gpioe 13 GPIO_ACTIVE_HIGH>;
		rf-u3r-gpios = <&gpioe 12 GPIO_ACTIVE_HIGH>;
		rf-v3r-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
		rf-u3t-gpios = <&gpioe 7 GPIO_ACTIVE_HIGH>;
		rf-v3t-gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
		rf-sw3t-gpios = <&gpioe 14 GPIO_ACTIVE_HIGH>;

		/*
		 * Audio path, found by reverse engineering. PE1 mutes the
		 * speaker when high, PE4 powers the audio amplifier, PB8 high
		 * takes the microphone off its line. PC12 selects the audio
		 * source: high for the BK4829 chips, low for the MCU DAC. PE9
		 * low routes the audio to the speaker instead of the Bluetooth
		 * module.
		 */
		spk-mute-gpios = <&gpioe 1 GPIO_ACTIVE_HIGH>;
		amp-pwr-gpios = <&gpioe 4 GPIO_ACTIVE_HIGH>;
		mic-mute-gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
		audio-sw-gpios = <&gpioc 12 GPIO_ACTIVE_HIGH>;
		bt-sw-gpios = <&gpioe 9 GPIO_ACTIVE_HIGH>;

		/*
		 * SI4732 broadcast receiver at address 0x11
		 */
		si4732-rst-gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
		si4732-scl-gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;
		si4732-sda-gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;

		/* Battery voltage through a resistive divider, ADC1 channel 1 */
		vbat-gpios = <&gpioa 1 0>;

		ptt-gpios = <&gpioe 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			    <&gpioe 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

		/* Programmable side keys: top (PE5) and bottom (PA12) */
		side-key-gpios = <&gpioe 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
				 <&gpioa 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

		/*
		 * Keypad matrix, columns are driven low one at a time and rows
		 * read back. PC4 is the VHF/UHF antenna relay and must never be
		 * touched by the keypad scan.
		 */
		kbd-col-gpios = <&gpioc 0 GPIO_ACTIVE_LOW>,
				<&gpioc 1 GPIO_ACTIVE_LOW>,
				<&gpioc 2 GPIO_ACTIVE_LOW>,
				<&gpioc 3 GPIO_ACTIVE_LOW>;
				
		/* Rows from top to bottom: PD7, PD6, PD5, PD4 */
		kbd-row-gpios = <&gpiod 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
				<&gpiod 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
				<&gpiod 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
				<&gpiod 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

		/* Rotary encoder, channel A and B */
		encoder-gpios = <&gpiob 4 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,
				<&gpiob 5 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
	};

	pwmleds {
		compatible = "pwm-leds";

		/* LCD backlight brightness, PC6 driven by TMR8 channel 1 */
		lcd_bl_pwm: lcd-bl-pwm {
			pwms = <&pwm8 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};

		/* Keypad backlight brightness, PB3 driven by TMR2 channel 2 */
		kbd_bl_pwm: kbd-bl-pwm {
			pwms = <&pwm2 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
	};
};

/* 1MHz timer clock: 120MHz / (119 + 1) */
&timer8 {
	at,prescaler = <119>;
	status = "okay";

	pwm8: pwm {
		pinctrl-0 = <&tmr8_ch1_default>;
		pinctrl-names = "default";
		status = "okay";
	};
};

/* 1MHz timer clock: 120MHz / (119 + 1) */
&timer2 {
	at,prescaler = <119>;
	status = "okay";

	pwm2: pwm {
		pinctrl-0 = <&tmr2_ch2_default>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};

&gpiod {
	status = "okay";
};

&gpioe {
	status = "okay";
};

/* 8MHz crystal, PLL x15: 120MHz system clock as in the vendor firmware */
&clk_hext {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&pll {
	/* Values are the HAL enumerators: mul = 13 is CRM_PLL_MULT_15 */
	mul = <13>;
	/* xtpre = 0 selects HEXT undivided as PLL input */
	xtpre = <0>;
	/* CRM_USB_DIV_2_5: 120MHz / 2.5 = 48MHz */
	div_fu = <2>;
	clocks = <&clk_hext>;
	status = "okay";
};

&sysclk {
	clock-frequency = <DT_FREQ_M(120)>;
	status = "okay";
};

&crm {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(120)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <2>;
	status = "okay";
};

&usart4 {
	/*
	 * Above the DMA interrupts (audio_rt950pro.c): a received character must
	 * be read before the next one, 87us later at 115200 Bd
	 */
	interrupts = <52 0>;
	pinctrl-0 = <&usart4_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* Bluetooth serial module (SPP) */
&usart1 {
	/*
	 * Below the audio DMA interrupts (audio_rt950pro.c)
	 */
	interrupts = <37 2>;
	pinctrl-0 = <&usart1_default>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};

&usart3 {
	/*
	 * Below the audio DMA interrupts (audio_rt950pro.c)
	 */
	interrupts = <39 2>;
	pinctrl-0 = <&usart3_default>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};

&adc1 {
	/*
	 * Below the audio DMA interrupts (audio_rt950pro.c): the battery voltage
	 * conversions must not delay them
	 */
	interrupts = <18 2>;
	at,adc-clock-source = "SYNC";
	at,adc-prescaler = <2>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 240)>;
		zephyr,resolution = <12>;
	};
};

/* External 4 MB SPI NOR: the vendor firmware keeps its data there */
&spi2 {
	pinctrl-0 = <&spi2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	extflash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		size = <DT_SIZE_M(32)>;
		has-dpd;
	};
};

/*
 * 224 kB of SRAM, selected by EOPB0 in the option bytes: platform_init()
 * makes sure it is (optionbytes.c).
 */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(224)>;
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Vendor bootloader, never overwritten */
		boot_partition: partition@0 {
			label = "bootloader";
			reg = <0x00000000 DT_SIZE_K(12)>;
			read-only;
		};

		/* OpenRTX image, uploaded through the vendor bootloader */
		code_partition: partition@3000 {
			label = "code";
			reg = <0x00003000 DT_SIZE_K(1004)>;
		};

		/* OpenRTX storage */
		storage_partition: partition@fe000 {
			reg = <0x000FE000 DT_SIZE_K(8)>;
		};
	};
};
