#
# Radtel RT-950 Pro board-specific configuration.
#
# Only options strictly related to the RT-950 Pro hardware belong here.
# SoC-level options for the Artery AT32F403A live in
# platform/mcu/AT32F403A/zephyr.conf.
#

# The vendor bootloader occupies the first 12kB of flash, the application is
# linked at the start of the code partition (0x08003000).
CONFIG_USE_DT_CODE_PARTITION=y

# Battery voltage ADC
CONFIG_ADC=y

# BK4829 shared 3-wire serial bus
CONFIG_SPI=y
CONFIG_SPI_BITBANG=y

# GPS NMEA reception on USART3
CONFIG_UART_INTERRUPT_DRIVEN=y

# Receive buffer of the Bluetooth serial module on USART1
CONFIG_RING_BUFFER=y

# ST7789V LCD on a bit-banged 8-bit 8080 parallel bus
CONFIG_DISPLAY=y
CONFIG_MIPI_DBI=y
CONFIG_MIPI_DBI_BITBANG=y
CONFIG_ST7789V=y
CONFIG_ST7789V_RGB565=y

# LCD backlight brightness control
CONFIG_PWM=y

# External SPI NOR flash (vendor calibration data)
CONFIG_SPI=y
CONFIG_SPI_NOR=y
# Geometry read from the chip (SFDP): its JEDEC ID is not known in advance
CONFIG_SPI_NOR_SFDP_RUNTIME=y

# Debug monitor (monitor.c): restart into the bootloader, SPI NOR ID and CRC
CONFIG_REBOOT=y
CONFIG_CRC=y
CONFIG_FLASH_JESD216_API=y
